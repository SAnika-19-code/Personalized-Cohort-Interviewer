# LLM Configuration
# Copy to .env.local and fill in your values

# OpenAI-compatible API endpoint (e.g., https://api.openai.com/v1, or your proxy)
LLM_BASE_URL=https://api.openai.com/v1

# API Key
LLM_API_KEY=your-api-key-here

# Model to use (gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.)
LLM_MODEL=gpt-4o-mini

# Enable LLM features (true/false)
# When false, falls back to rule-based system
USE_LLM=true

# Fallback to rule-based on LLM errors (true/false)
LLM_FALLBACK_ON_ERROR=true